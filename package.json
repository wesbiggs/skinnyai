    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:sea": "node scripts/build-sea.mjs --out build/skinnyai",
    "build:app": "scripts/build-app.sh"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "postject": "^1.0.0-alpha.6",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
