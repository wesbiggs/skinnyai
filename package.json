{
  "name": "skinnyai",
  "version": "0.9.0",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "skinnyai": "bin/skinnyai.js"
  },
  "files": [
    "bin"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ollama": "node src/skinnyai.js",
    "openai": "node src/skinnyai.js --api openai",
